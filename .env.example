# Copy this file to ".env" and fill it in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Path to the Firebase service-account key (download a NEW one after rotating the old key)
FIREBASE_CREDENTIALS=firebase-adminsdk.json
FIREBASE_DATABASE_URL=https://cbwci-892de-default-rtdb.firebaseio.com/

# Set to true once the site is served over https
SESSION_COOKIE_SECURE=false

# Local development only. Leave false on the live site.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Used by admin_init.py when creating the predefined admins (or leave empty to be prompted)
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
